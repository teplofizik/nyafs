<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<Authors>Alexey Sonkin</Authors>
		<Description>Pure C# filesystem readers/builders + mini script core to manage operations with images (kernel/ramfs/devtree</Description>
		<PackageProjectUrl>https://github.com/teplofizik/NyaFS.git</PackageProjectUrl>
		<RepositoryUrl>https://github.com/teplofizik/NyaFS.git</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<LangVersion>latest</LangVersion>
    <Version>1.0.23</Version>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="ImageFormat\Elements\Fs\Reader\CpioReader.cs" />
		<Compile Remove="ImageFormat\Elements\Fs\Writer\CpioWriter.cs" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<Compile Remove="Processor\Scripting\Plugins\PluginLoadContext.cs" />
		<Compile Remove="Processor\Scripting\Plugins\PluginLoader.cs" />
		<Compile Remove="Processor\Scripting\Commands\SystemCmd.cs" />
		<Compile Remove="ImageFormat\Elements\Fs\Reader\NativeReader.cs" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ImageFormat\Plugins\ImagePlugins\KernelPlugins\" />
		<Folder Include="Processor\Scripting\Commands\Kernel\" />
	</ItemGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>NyaFsTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CrcSharp" Version="1.2.0" />
		<PackageReference Include="FT.LZ4" Version="1.0.0" />
		<PackageReference Include="LZMA-SDK" Version="19.0.0" />
		<PackageReference Include="NyaIO" Version="1.0.1" />
		<PackageReference Include="NyaLZO" Version="1.0.2" />
		<PackageReference Include="NyaXZ" Version="1.0.0" />
		<PackageReference Include="SharpCompress" Version="0.50.5" />
		<PackageReference Include="SharpZipLib" Version="1.3.3" />
		<PackageReference Include="ZstdSharp.Port" Version="0.6.3" />
	</ItemGroup>

</Project>

